#!/bin/sh
# aurora-bw-collect: lê os contadores e imprime a lista de aparelhos em JSON.
#   Wi-Fi: contadores exatos da estação (iw).
#   Cabo:  contadores da PORTA física onde o aparelho está (um aparelho por porta).
#          A porta de cada aparelho é descoberta sozinha pela tabela de encaminhamento da ponte (br-lan),
#          então não é preciso configurar nada quando um aparelho muda de porta.
# Roda em laço no rc.local e grava /tmp/aurora-bw.json a cada segundo; o CGI só devolve esse arquivo.
#
# Nome do aparelho (hostname), na ordem de preferência:
#   1. nome que o aparelho enviou ao DHCP (/tmp/dhcp.leases)
#   2. último nome válido já visto (cache em /etc/aurora-custom/names.tsv, guardado na flash)
#   3. nome do DHCPv6 (odhcpd) para o IPv6 que o aparelho usa agora
#   4. o próprio IP

LEASES=/tmp/dhcp.leases
NAMES_RAM=/tmp/aurora-names.tsv           # cache em RAM (atualizado a cada leitura)
NAMES_FLASH=/etc/aurora-custom/names.tsv  # cópia persistente (só gravada quando muda)
PORTS_RAM=/tmp/aurora-ports.tsv           # último mapeamento aparelho -> porta (a tabela da ponte esquece quem fica parado)
PORTS_FLASH=/etc/aurora-custom/ports.tsv  # cópia persistente
[ -s "$PORTS_RAM" ] || [ ! -s "$PORTS_FLASH" ] || cp "$PORTS_FLASH" "$PORTS_RAM"
T=/tmp/aurora-bw.$$

# cache: a cópia da flash é usada se a RAM estiver vazia (ex.: após reinício)
[ -s "$NAMES_RAM" ] || [ ! -s "$NAMES_FLASH" ] || cp "$NAMES_FLASH" "$NAMES_RAM"

# Lê os dois rádios ao mesmo tempo (cada station dump leva ~0,3 s sob carga)
for d in $(ls /sys/class/net 2>/dev/null | grep -E '^phy[0-9]+-ap[0-9]+$'); do
  iw dev "$d" station dump > "$T.$d" 2>/dev/null &
done
wait

LANPORTS=$(ls /sys/class/net 2>/dev/null | grep -E '^lan[0-9]+$')

{
  echo "LEASE"; cat "$LEASES" 2>/dev/null
  echo "NAMES"; cat "$NAMES_RAM" 2>/dev/null
  echo "PCACHE"; cat "$PORTS_RAM" 2>/dev/null
  echo "NEIGH4"; ip neigh show dev br-lan 2>/dev/null
  echo "V6";    ip -6 neigh show dev br-lan 2>/dev/null
  echo "HOSTS6"; cat /tmp/hosts/odhcpd.hosts.lan 2>/dev/null
  # número da porta na ponte -> nome da porta (lan2, lan3...)
  echo "PN"
  for p in $LANPORTS; do echo "$p $(( $(cat /sys/class/net/$p/brport/port_no 2>/dev/null) ))"; done
  # tabela de encaminhamento da ponte: 16 bytes por entrada (MAC[6], porta, é_local, ...)
  echo "FDB"; hexdump -v -e '16/1 "%u " "\n"' /sys/class/net/br-lan/brforward 2>/dev/null
  # contadores de cada porta: nome, bytes recebidos (do aparelho), bytes enviados (ao aparelho)
  echo "PSTATS"
  for p in $LANPORTS; do
    echo "$p $(cat /sys/class/net/$p/statistics/rx_bytes 2>/dev/null) $(cat /sys/class/net/$p/statistics/tx_bytes 2>/dev/null) $(cat /sys/class/net/$p/carrier 2>/dev/null)"
  done
  for f in "$T".*; do [ -f "$f" ] && { echo "IW"; cat "$f"; }; done
} | awk -v ts="$(cut -d' ' -f1 /proc/uptime)" -v newnames=/tmp/aurora-names.new '
# ts = segundos desde o boot no momento da leitura: a página usa para calcular a velocidade com o tempo real
/^LEASE$/   { sec = "lease";   next }
/^NAMES$/   { sec = "names";   next }
/^NEIGH4$/   { sec = "neigh4";  next }
/^V6$/      { sec = "v6";      next }
/^HOSTS6$/  { sec = "hosts6";  next }
/^PN$/      { sec = "pn";      next }
/^FDB$/     { sec = "fdb";     next }
/^PSTATS$/  { sec = "pstats";  next }
/^PCACHE$/  { sec = "pcache";  next }
/^IW$/      { sec = "iw";      next }

sec == "lease" && NF >= 4 {
  mac = tolower($2); ip = $3
  n++; lmac[n] = mac; lip[n] = ip; lset[mac] = 1
  if ($4 != "*") { lname_dhcp[mac] = $4; print mac "\t" $4 > newnames }   # nome real do DHCP: guarda no cache
}
sec == "names" && NF >= 2 { cache[$1] = $2 }
# endereço IPv6 -> MAC (vizinhos ativos) e endereço IPv6 -> nome (odhcpd)
sec == "neigh4" { for (i = 1; i <= NF; i++) if ($i == "lladdr" && $1 !~ /:/) n4[tolower($(i + 1))] = $1 }
sec == "v6" { for (i = 1; i <= NF; i++) if ($i == "lladdr") v6mac[$1] = tolower($(i + 1)) }
sec == "hosts6" && NF >= 2 { v6name[$1] = $2 }
# número da porta -> nome da porta
sec == "pn" && NF == 2 { pname[$2] = $1 }
# tabela da ponte: MAC aprendido numa porta física (não local) -> nome da porta
sec == "fdb" && NF == 16 && $8 == 0 && ($7 in pname) {
  mac = sprintf("%02x:%02x:%02x:%02x:%02x:%02x", $1, $2, $3, $4, $5, $6)
  pm[mac] = pname[$7]
}
sec == "pstats" && NF >= 3 { prx[$1] = $2; ptx[$1] = $3; pcar[$1] = $4 + 0 }   # carrier 1 = cabo ligado ao aparelho
# mapeamento guardado de antes: vale enquanto a tabela da ponte não aprender o aparelho de novo
sec == "pcache" && NF == 2 { pc[$1] = $2 }

# iw visto pelo roteador: "tx bytes" = enviado PARA o aparelho (download dele); "rx" = vindo dele (upload)
sec == "iw" && /^Station/ { mac = tolower($2) }
sec == "iw" && /rx bytes/ { wrx = $3 }
sec == "iw" && /tx bytes/ { wdn[mac] = $3; wup[mac] = wrx }

END {
  # nome pelo DHCPv6: MAC que usa um IPv6 que também está no odhcpd
  for (a in v6mac) if (a in v6name) m6[v6mac[a]] = v6name[a]
  for (k in pc) if (!(k in pm) && (pc[k] in ptx)) pm[k] = pc[k]      # usa o mapeamento guardado
  for (k in pm) print k "\t" pm[k] > "/tmp/aurora-ports.new"          # grava para a próxima leitura
  printf "[\n"; first = 1
  for (i = 1; i <= n; i++) {
    m = lmac[i]; ip = lip[i]
    # porta: o que o aparelho recebe é o que a porta ENVIA, e vice-versa
    up = "true"
    if (m in wdn)       { rx = wdn[m]; tx = wup[m]; via = "wifi" }
    else if (m in pm)   { p = pm[m]; rx = ptx[p] + 0; tx = prx[p] + 0; via = "lan"; up = (pcar[p] == 1) ? "true" : "false" }
    else continue
    name = (m in lname_dhcp) ? lname_dhcp[m] : (m in cache) ? cache[m] : (m in m6) ? m6[m] : ip
    if (!first) printf ",\n"
    first = 0
    printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"name\":\"%s\",\"rx\":%s,\"tx\":%s,\"via\":\"%s\",\"port\":\"%s\",\"up\":%s,\"ts\":%s}", m, ip, name, rx + 0, tx + 0, via, (via == "lan" ? p : ""), up, ts
  }
  # porta cabeada sem lease DHCP (ex.: outro roteador ligado no cabo): usa o IP do ARP e o nome do cache
  for (m in pm) {
    if (m in lset || m in wdn) continue
    p = pm[m]; ip = (m in n4) ? n4[m] : m
    name = (m in cache) ? cache[m] : ip
    up = (pcar[p] == 1) ? "true" : "false"
    if (!first) printf ",\n"
    first = 0
    printf "{\"mac\":\"%s\",\"ip\":\"%s\",\"name\":\"%s\",\"rx\":%s,\"tx\":%s,\"via\":\"lan\",\"port\":\"%s\",\"up\":%s,\"ts\":%s}", m, ip, name, ptx[p] + 0, prx[p] + 0, p, up, ts
  }
  printf "\n]\n"
}'

# atualiza o cache de nomes: nomes lidos agora têm prioridade; a flash só é regravada se mudou
{ cat /tmp/aurora-names.new 2>/dev/null; cat "$NAMES_RAM" 2>/dev/null; } | awk -F'\t' 'NF >= 2 && !seen[$1]++' > "$NAMES_RAM.tmp" && mv "$NAMES_RAM.tmp" "$NAMES_RAM"
cmp -s "$NAMES_RAM" "$NAMES_FLASH" || cp "$NAMES_RAM" "$NAMES_FLASH"
# mapeamento aparelho -> porta: só regrava a flash quando algum aparelho mudou de porta
if [ -s /tmp/aurora-ports.new ]; then mv /tmp/aurora-ports.new "$PORTS_RAM"; fi
cmp -s "$PORTS_RAM" "$PORTS_FLASH" || cp "$PORTS_RAM" "$PORTS_FLASH"
rm -f "$T".* /tmp/aurora-names.new
