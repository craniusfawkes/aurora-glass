#!/bin/sh
# aurora-bw: returns the last ready reading (/tmp/aurora-bw.json), written every second
# by the background collector. If there is no reading yet, runs the collector once.

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

F=/tmp/aurora-bw.json
if [ -s "$F" ]; then cat "$F"; else /etc/aurora-custom/bw-collect.sh; fi
